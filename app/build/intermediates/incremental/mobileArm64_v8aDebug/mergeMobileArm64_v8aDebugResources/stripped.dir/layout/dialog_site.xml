<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_shell_proxy_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/keyword"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:background="@drawable/shape_danmaku_search_keyword"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:hint="@string/site_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="textCapWords|textAutoCorrect|textAutoComplete"
            android:maxLength="255"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#202124"
            android:textColorHint="#8A8F98"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/ic_site_search"
            app:drawableTint="@color/dialog_outlined_button_text" />

        <!-- 仅脚本文件夹接口显示：编辑打开脚本管理，刷新重扫当前目录 -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/edit"
            android:layout_width="32dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/script_edit"
            android:padding="4dp"
            android:scaleType="center"
            android:src="@drawable/ic_git_cloud_edit"
            android:visibility="gone"
            app:tint="@color/dialog_outlined_button_text"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/refresh"
            android:layout_width="32dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/config_refresh"
            android:padding="4dp"
            android:scaleType="center"
            android:src="@drawable/ic_setting_refresh"
            android:visibility="gone"
            app:tint="@color/dialog_outlined_button_text"
            tools:visibility="visible" />

        <!-- 全选 / 反选：仅在搜索范围弹窗显示，作用范围为筛选后当前显示的站点 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/site_select_all"
            android:textAllCaps="false"
            android:textColor="@color/dialog_outlined_button_text"
            android:textSize="11sp"
            android:visibility="gone"
            app:backgroundTint="@color/dialog_outlined_button_bg"
            app:strokeColor="@color/dialog_outlined_button_stroke"
            app:strokeWidth="1dp"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/invert"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/site_invert"
            android:textAllCaps="false"
            android:textColor="@color/dialog_outlined_button_text"
            android:textSize="11sp"
            android:visibility="gone"
            app:backgroundTint="@color/dialog_outlined_button_bg"
            app:strokeColor="@color/dialog_outlined_button_stroke"
            app:strokeWidth="1dp"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/block"
            android:layout_width="24dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_site_hidden"
            app:tint="@color/dialog_outlined_button_text" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/search"
            android:layout_width="24dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_site_single_column"
            app:tint="@color/dialog_outlined_button_text" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <HorizontalScrollView
        android:id="@+id/groupScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/groupList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:maxHeight="376dp" />

</androidx.appcompat.widget.LinearLayoutCompat>
